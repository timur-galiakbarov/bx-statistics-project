{
  "name": "@socstat/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "npm run dev --workspace @socstat/api",
    "mongo:start": "docker compose -f docker-compose.dev.yml up -d",
    "mongo:stop": "docker compose -f docker-compose.dev.yml down",
    "build:frontend": "tsc -b && vite build",
    "build": "npm run build --workspace @socstat/api && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test --workspace @socstat/api && tsc -b --noEmit"
  },
  "dependencies": {
    "@alfalab/core-components-button": "^13.2.2",
    "@alfalab/core-components-calendar-input": "^12.0.18",
    "@alfalab/core-components-config": "^1.1.0",
    "@alfalab/core-components-icon-button": "^8.0.10",
    "@alfalab/core-components-input": "^17.2.0",
    "@alfalab/core-components-modal": "^11.0.15",
    "@alfalab/core-components-segmented-control": "^3.1.5",
    "@alfalab/core-components-select": "^19.2.5",
    "@alfalab/core-components-skeleton": "^7.0.4",
    "@alfalab/core-components-stack-context": "^1.0.1",
    "@alfalab/core-components-tooltip": "^9.0.19",
    "@vitejs/plugin-react": "^4.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
