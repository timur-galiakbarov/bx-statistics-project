{
  "name": "@socstat/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "npm run dev --workspace @socstat/api",
    "build": "npm run build --workspace @socstat/api && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test --workspace @socstat/api && tsc -b --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
